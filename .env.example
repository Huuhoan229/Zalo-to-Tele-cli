TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_FORUM_CHAT_ID=-1001234567890

# Optional. Comma-separated Telegram user IDs allowed to send messages from Telegram to Zalo.
# Leave empty to allow any member who can write in the forum group.
ALLOWED_TELEGRAM_USER_IDS=

# zca-js login mode:
# - auto: use saved cookie if available, otherwise show QR
# - qr: always show QR/login flow
# - cookie: only load Zalo Web cookies/imei/userAgent from ZALO_CREDENTIALS_FILE
ZALO_LOGIN_MODE=auto
ZALO_CREDENTIALS_FILE=sessions/zalo-credentials.json
ZALO_SELF_LISTEN=true

DATA_FILE=data/store.json
DOWNLOAD_DIR=downloads
LOG_LEVEL=info
